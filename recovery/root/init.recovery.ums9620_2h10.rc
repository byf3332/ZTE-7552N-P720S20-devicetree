# Device wrapper for the stock Unisoc recovery init fragment.
import /init.recovery.common.rc

# KeyMint 2.0 is storage-key compatible with the Keymaster 4.x client path.
on early-init
    # soc-thmzone is a virtual sensor backed by the Unisoc r5p0 hardware zones.
    # Load both providers before TWRP starts reading thermal_zone4.
    insmod /lib/modules/sprd_thermal_r5p0.ko
    insmod /lib/modules/sprd_soc_thm.ko
    setprop keymaster_ver 4.x

# Android 13 uses Trusty KeyMint 2.0 while TWRP 12.1 ships a KeyMint V1
# client. The stable AIDL V2 service is backward compatible with that client.
service p720s20-keymint /system/bin/hw/android.hardware.security.keymint@2.0-unisoc.service.trusty
    class early_hal
    user root
    group root
    setenv LD_LIBRARY_PATH /system/lib64/p720s20-keymint:/system/lib64
    seclabel u:r:recovery:s0
    disabled

# Match the stock Unisoc secure-storage chain. Gatekeeper cannot open its
# persistent storage until the RPMB and normal-world proxies are connected.
service p720s20-rpmbproxy /system/bin/sprdstorageproxyd -f rpmb -d /dev/trusty-ipc-dev0 -p /data/vendor/sprd_ss -r /dev/mmcblk0rpmb
    class core
    user root
    group root system
    setenv LD_LIBRARY_PATH /system/lib64/p720s20-keymint:/system/lib64
    seclabel u:r:recovery:s0
    disabled

service p720s20-nsproxy /system/bin/sprdstorageproxyd -f ns -d /dev/trusty-ipc-dev0 -p /data/vendor/sprd_ss -r /dev/mmcblk0rpmb
    class core
    user root
    group root system
    setenv LD_LIBRARY_PATH /system/lib64/p720s20-keymint:/system/lib64
    seclabel u:r:recovery:s0
    disabled

service p720s20-tee-rpc /system/bin/tee_rpc
    class core
    user root
    group root system
    setenv LD_LIBRARY_PATH /system/lib64/p720s20-keymint:/system/lib64
    seclabel u:r:recovery:s0
    disabled

# Unisoc TrustOS keeps Gatekeeper as a signed dynamic TA. Its vendor
# tsupplicant loads /odm/firmware/gatekeeper.elf before the HAL connects.
service p720s20-tsupplicant /system/bin/tsupplicant firmware
    class core
    user root
    group root system
    setenv LD_LIBRARY_PATH /system/lib64/p720s20-keymint:/system/lib64
    seclabel u:r:recovery:s0
    disabled

service p720s20-gatekeeper /system/bin/hw/android.hardware.gatekeeper@1.0-service.trusty
    class hal
    user root
    group root system
    setenv LD_LIBRARY_PATH /system/lib64/p720s20-keymint:/system/lib64
    seclabel u:r:recovery:s0
    disabled

on property:init.svc.servicemanager=running
    start p720s20-keymint

# Match the stock service order after the data and Trusty devices are ready.
on boot
    mkdir /data/vendor/sprd_ss 0770 system system
    mkdir /data/vendor/sprd_tee_ss 0770 system system
    symlink /dev/rpmb0 /dev/mmcblk0rpmb
    chown system system /dev/rpmb0
    chmod 0660 /dev/rpmb0
    chown system system /dev/trusty-ipc-dev0
    chmod 0660 /dev/trusty-ipc-dev0
    start p720s20-rpmbproxy
    start p720s20-nsproxy
    start p720s20-tee-rpc
    start p720s20-tsupplicant
    start p720s20-gatekeeper
